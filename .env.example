# Copiá este archivo como ".env" y completá tus datos. No compartas el .env con nadie.

# Access Token de Mercado Pago (Tus integraciones > tu aplicación > Credenciales).
# Para probar usá el de PRUEBA (empieza con TEST-). Para cobrar de verdad, el de PRODUCCIÓN (APP_USR-).
MP_ACCESS_TOKEN=

# Vercel Blob (donde se guardan las publicaciones y sus fotos).
# Se crea en Vercel: tu proyecto > Storage > Create > Blob. Vercel lo carga solo al publicar;
# para probar en tu compu, copialo desde Storage > tu Blob > .env.local
BLOB_READ_WRITE_TOKEN=

# Contraseña para entrar al panel /admin y subir o borrar publicaciones. Usá una larga y que no uses en otro lado.
ADMIN_PASSWORD=

# Dirección pública de la tienda cuando la subas a internet (ej: https://ultragaming.com.ar).
# Si la dejás vacía, se usa la dirección desde la que se abrió la tienda.
BASE_URL=
